;aspect-ratio:16/9;padding:20px;margin:20px 0;background-color:var(--pink)}.Article_articleEndVideoTest__XhhEd .Article_moreReadVideo__RSZWt{font-size:1em;margin-bottom:.5em;font-weight:900;line-height:1.12em;color:#fff}.Article_articleEndVideoMobile__J9f4b{background:var(--pink);color:#fff;top:0;left:0;padding:10px 20px;display:flex;align-items:center}.Article_updateArticle__RSk42{position:-webkit-sticky;position:sticky;top:100px;right:0;z-index:99999}.Article_updateArticleLink__kLOiX{display:inline-block;padding:12px 22px;color:var(--bgColor);background:var(--pink);position:absolute;border-radius:100px;margin:20px;box-shadow:0 4px 4px rgba(0,0,0,.1)}@keyframes Article_fadeIn__lz7ZC{0%{opacity:0}to{opacity:1}}.Slider_mainSlider___vU7J{position:relative;height:100vh}@media screen and (max-width:620px){.Slider_mainSlider___vU7J{height:calc(var(--vh)*100)}}.Slider_sliderButtons__EYiuf{position:absolute;width:100%;left:0;bottom:90px;z-index:98}@media screen and (max-width:620px){.Slider_sliderButtons__EYiuf{bottom:0}}.Slider_sliderPauseContainer__ycAty{position:absolute;bottom:0;left:0;z-index:9}.Slider_sliderButtonsList__8I71Q{width:100%;display:flex;align-items:center;justify-content:flex-start;padding:0 80px;transition:opacity .4s ease-in-out}@media screen and (max-width:620px){.Slider_sliderButtonsList__8I71Q{padding:0 30px 40px}}.Slider_sliderButtonsList__8I71Q li{margin-right:6px}.Slider_sliderButtonsList__8I71Q li button{width:45px;height:45px;position:relative}.Slider_sliderButtonsList__8I71Q li button:after,.Slider_sliderButtonsList__8I71Q li button:before{display:block;width:100%;height:5px;content:\"\";position:absolute;top:50%;left:0;transform:translateY(-50%);border-radius:10px}.Slider_sliderButtonsList__8I71Q li button:before{background:rgba(", "url": "https://www.lebonbon.fr/_next/static/css/e2151f0a7f081b67.css"}, {"from": "Le Bonbon", "at": "2026-11-01T05:18:24", "subject": "", "text": "Ce nouveau lieu culturel XXL de 6 000 m² s’apprête à ouvrir aux portes de Paris | Le Bonbon Modifier article Ce nouveau lieu culturel XXL de 6 000 m² s’apprête à ouvrir aux portes de Paris undefined undefined undefined 13h00 Maria Sumalla © Encore Heureux @ateliersmedicis En Seine-Saint-Denis, un vaste projet culturel se dessine à Montfermeil. Dès 2027, les Ateliers Médicis investiront un bâtiment de 6 000 m² pensé pour faire dialoguer création artistique, formation et vie locale. Modifier article OK Voilà un nouveau lieu culturel dont on attend l’ouverture avec impatience. Après le centre Large sur l’Île Seguin ou encore Les Grandes Serres de Pantin , c’est au tour des Ateliers Médicis de voir le jour en Seine-Saint-Denis en 2027. L’idée du projet ? Offrir aux artistes et au public de la région un immense bâtiment de 6 000 m² entièrement dédié à la création artistique, avec salles de spectacle, cinéma, espaces d’exposition, ateliers et jardins. Un nouveau chapitre pour les Ateliers Médicis Créés en 2015, les Ateliers Médicis accompagnent des artistes de toutes disciplines, allant du cinéma à la danse, en passant par la musique, les arts plastiques et le théâtre . Actuellement installé dans un bâtiment provisoire à Clichy-sous-Bois, cet espace créatif et pluridisciplinaire développe des résidences, des projets participatifs et des rencontres entre créateurs et habitants. Voir cette publication sur Instagram Une publication partagée par Ateliers Médicis (@ateliersmedicis) Mais un véritable tournant s’annonce pour les Ateliers Médicis courant 2027 avec l’ouverture d’un nouveau bâtiment flambant neuf. C’est dans l’ancienne tour Utrillo à Montfermeil, démolie en 2017, que ce nouveau hot spot créatif de l’Île-de-France prévoit de s’installer, réunissant dans un seul et même lieu artistes, jeunes en formation et public. Et si le chantier est encore en cours, on peut dire que le projet avance bien. Le 1er octobre dernier, ont été achevés les gros œuvre ainsi que la toiture du bâtiment, marquant une grande étape avant une livraison envisagée à l’automne prochain. Un lieu de création ouvert à tous À quoi s’attendre pour ces nouveaux Ateliers Médicis ? Le grand bâtiment imaginé par l’agence d’architecture Encore Heureux, réparti en cinq niveaux, accueillera de salles de spectacle et de salles de cinéma pour accueillir artistes et public. Mais aussi, des espaces d’exposition , des studios de création, des ateliers et autres espaces de résidence artistique. Des écoles réputées comme l’école de cinéma Kourtrajmé ou encore l’école d’art alternative La Renverse prévoient déjà de s’y installer. Voir cette publication sur Instagram Une publication partagée par Ateliers Médicis (@ateliersmedicis) Un carrefour culturel qui risque bien de faire briller la Seine-Saint-Denis , tout en devenant un véritable lieu de vie. Sur place, un restaurant prendra place au troisième étage, tandis qu’artistes et habitants pourront profiter de 1 000 m² de terrasses, de 2 000 m² de parvis et de 1 200 m² de jardin. Les Ateliers Médicis Plus d’infos", "url": "https://www.lebonbon.fr/paris/culture/nouveau-lieu-culturel-xxl-6000-m2-ouvrir-portes-paris/"}, {"from": "Le Bonbon", "at": "2026-11-01T05:18:24", "subject": "", "text": "3 bonnes raisons d’aller voir J’espère que nos enfants iront mieux que nous au Théâtre de la Pépinière | Le Bonbon Modifier article 3 bonnes raisons d’aller voir J’espère que nos enfants iront mieux que nous au Théâtre de la Pépinière undefined undefined 27 octobre 2026 undefined 15h00 undefined undefined 30 octobre 2026 undefined 15h25 Rachel Thomas © Alejandro Guerrero Et si un test ADN pouvait vous dire ce que votre bébé va devenir ? Rudy Milstein en a fait une comédie aussi grinçante que réjouissante, à voir à la Pépinière Théâtre. On vous dit pourquoi il faut foncer au plus vite. Modifier article OK Après le carton de C’est pas facile d’être heureux quand on va mal , Rudy Milstein était attendu au tournant. Et le Molière 2024 ne déçoit pas : avec sa nouvelle pièce, il s’attaque à la maternité, au désir d’enfant et à cette angoisse très contemporaine de vouloir tout maîtriser , jusqu’à l’ADN de son bébé. Le résultat ? Une comédie qui fait rire jaune autant qu’aux éclats , portée par une troupe en grande forme. Voilà pourquoi on vous la recommande les yeux fermés. 1. Parce qu'on adore l'humour noir Le pitch est déjà un petit bijou de comédie noire : Marie se retrouve à la maternité avec sa meilleure amie Anne, qui vient elle aussi d’accoucher, mais de son troisième, arrivé par accident. Pour mettre toutes les chances de son côté, Marie a fait faire à son nouveau-né un test génétique révolutionnaire censé prédire ses risques de maladies . Le résultat est mauvais… Alors elle échange discrètement son bébé avec celui d’Anne . À partir de là, tout dérape avec délice : névroses parentales, couples qui s’essaient au couple libre, parents franchement monstrueux… Voir cette publication sur Instagram Une publication partagée par Théâtre La Pépinière (@theatre_lapepiniere) 2. Pour le casting de choc En tête d’affiche, Anne Marivin, visage culte du cinéma français depuis Bienvenue chez les Ch’tis , irrésistible en mère débordée. Face à elle, Ariane Mourier , habituée de la Pépinière, en mère prête à tout pour avoir l’enfant parfait, et Nicolas Lumbreras, fidèle complice de Rudy Milstein, toujours aussi redoutable. Erwan Téréné et Maeva Pinto Lopes, épatante en infirmière , complètent la troupe, le tout ponctué en live par une clarinette. On salue fort des comédiens explosifs ! 3. Parce que ça fait relativiser Derrière les éclats de rire, la pièce tend un miroir pas toujours flatteur à notre obsession du contrôle , du bébé parfait et de la parentalité optimisée. Cruelle mais terriblement juste sur notre époque, elle fait l’effet d’une petite séance de thérapie collective : on ressort en se disant que nos névroses ne sont finalement pas si graves… et que nos enfants s’en sortiront très bien, test ADN ou pas . Bref, entre un pitch culotté, une troupe au top et des répliques qui piquent , J'espère que nos enfants iront mieux que nous coche toutes les cases de la comédie qu’on a envie de recommander à tous ses amis (surtout ceux qui viennent d’avoir un bébé). Attention, la pièce fait souvent salle pleine : on ne traîne pas pour réserver. J’espère que nos enfants iront mieux que nous , de Rudy Milstein La Pépinière Théâtre 7 rue Louis-Le-Grand – 2e De 43 à 51 € Plus d'infos Culture Ce nouveau lieu culturel XXL de 6 000 m² s’apprête à ouvrir aux portes de Paris Culture Palais de Tokyo : nos 5 coups de coeur de la saison « Tous les feux, les fleurs » Culture Pour ses 10 ans, le MAIF Social Club met la résistance à l’honneur", "url": "https://www.lebonbon.fr/paris/culture/raisons-j-espere-que-nos-enfants-iront-mieux-theatre-pepiniere/"}, {"from": "Le Bonbon", "at": "2026-11-01T05:18:24", "subject": "", "text": "Art Basel : 6 oeuvres d’art à voir gratuitement dans les rues de Paris | Le Bonbon Modifier article Art Basel : 6 oeuvres d’art à voir gratuitement dans les rues de Paris undefined undefined 23 octobre 2026 undefined 08h30 undefined undefined 23 octobre 2026 undefined 12h16 Maria Sumalla Avis aux amateurs d’art contemporain. Cette semaine, des œuvres monumentales font leur apparition dans les rues de Paris, à l’occasion de l’édition 2026 d’Art Basel. On vous présente nos six pièces préférées, à découvrir gratuitement jusqu’au 25 octobre ! Modifier article OK Art Basel Paris revient illuminer la capitale française cette semaine ! Après une édition 2025 couronnée de succès avec plus de 73 000 visiteurs et des représentants de plus de 240 musées et institutions venus du monde entier, l'événement s'affirme une fois de plus comme le point d'orgue de la saison artistique parisienne. Pendant 3 jours, artistes et galeries venus des quatre coins de la planète nous présenteront leur art, sous le regard avisé de collectionneurs, commissaires et amateurs d'art, le tout, sous la nef du Grand Palais. Mais comme d’habitude, la foire d’art s’exporte aussi hors-les-murs, ancrée dans la vie culturelle de la capitale, et invite les Parisiens à découvrir gratuitement des œuvres spectaculaires. En voici six à ne pas louper ! 1. Tracey Emin sur le parvis des Droits-de-l’Homme Face à la tour Eiffel, l’artiste britannique Tracey Emin a érigé trois installations en bronze monumentales. Jusqu’au 1er novembre, découvrez sur le parvis des Droits-de-l’Homme un triptyque mêlant vulnérabilité et force, au cœur des l’une des places les plus touristiques de la capitale. Voir cette publication sur Instagram Une publication partagée par Tracey Emin ARTIST (@traceyeminstudio) I lay here for you, I Followed You to the End et I Will Not Be Alone , Tracey Emin Parvis des Droits-de-l’Homme – 16e Du 14 octobre au 1er novembre 2026 2. Huits oeuvres sur l’avenue Winston Churchill Alors que la foire d’art se déroule actuellement sous la nef Grand Palais, Art Basel s’exporte hors les murs et expose huit œuvres d’arts sur l’avenue piétonne Winston Churchill, menant jusqu’au Petit Palais. Au programme ? Un bras de nacelle avec néon de Marcello Maloberti, des étoffes de bronze de Yinka Shonibare, des sphères de pierre empilées d’Alicja Kwade, un chevron jaune flottant de Carmen Herrera, ou encore le Cat Head Totem signé Niki de Saint Phalle. On vous laisse découvrir le reste au détour d’une promenade dans le 8e ! Voir cette publication sur Instagram Une publication partagée par Alicja Kwade (@alicjakwade) Avenue Winston-Churchill – 8e Du 20 au 25 octobre 2026 3. Les peluches géantes de Cosima von Bonin au Petit Palais On continue la balade dans le 8e et on s’offre un détour vers le Petit Palais, où l’on retrouve notamment une galerie de sculptures d’animaux en peluche géantes par l’artiste allemande Cosima von Bonin. Orque en mohair, poulpe en cuir, homard en velours… L'institution ouvre ses portes aux Dollys & Beaux tout le week-end . Voir cette publication sur Instagram Une publication partagée par Petzel (@petzelgallery) Dollys & Beaux , Cosima von Bonin Petit Palais – 8e Du 20 au 25 octobre 2026 4. Oiseaux en bronze de Lionel Sabatté au Square Jean-Perrin Toujours dans le quartier du Grand Palais, le square Jean-Perrin accueille durant toute la durée de la foire d’art des œuvres de l'artiste peintre Lionel Sabatté. Au cœur de ce petit espace vert, ces installations mi-oiseaux mi-totems en bronze donnent le ton Art Basel. Voir cette publication sur Instagram Une publication partagée par journal du design © (@journaldudesign) Champs d’Oiseaux , Lionel Sabatté Square Jean-Perrin – 8e Du 20 au 25 octobre 2026 5. Un travail de mémoire Kutluğ Ataman aux Beaux-Arts On change de quartier et on passe côté rive gauche, où l’artiste turc Kutluğ Ataman dévoile une œuvre monumentale dans la chapelle des Petits-Augustins des Beaux Arts de Paris. Fauteuils et téléviseurs envahissent l’espace, racontant la vie de quarante habitants de Küba , quartier et bidonville d’Istanbul. Voir cette publication sur Instagram Une publication partagée par Niru Ratnam (@niruratnamgallery) Küba, Kutluğ Ataman Beaux-Arts de Paris 14, rue Bonaparte – 6e Du 20 au 25 octobre 2026 6. Alice Diop et Miu Miu au Palais d’Iéna La réalisatrice Alice Diop, qu’on a notamment adorée et acclamée pour Saint Omer , laisse de côté le cinéma pour installer au cœur du Palais d’Iéna une œuvre qui se traverse. Aux côtés de Miu Miu, la réal érige une bibliothèque , une salle de projection ou encore une arène où des comédiennes s’expriment. Voir cette publication sur Instagram Une publication partagée par Salut les Garçons (@salutlesgarcons) Geste de consolation , Alice Diop et Miu Miu Palais d’Iéna – 16e Du 21 au 25 octobre 2026", "url": "https://www.lebonbon.fr/paris/culture/art-basel-2026-oeuvres-art-voir-gratuitement-rues-paris/"}, {"from": "Télérama", "at": "2026-11-01T05:18:24", "subject": "", "text": ".sr-only{border:0!important;clip:rect(1px,1px,1px,1px)!important;-webkit-clip-path:inset(50%)!important;clip-path:inset(50%)!important;height:1px!importa